---
import { getCollection } from 'astro:content';

let posts = [];
try {
  posts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
} catch (e) {
  console.error(e);
}
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VITA | 智能健康与前沿养生指南</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-color: #fcfbf9;
      --card-bg: #ffffff;
      --text-main: #1c2520;
      --text-muted: #6b7c72;
      --accent-color: #2e5b44;
      --border-color: #e8ece9;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      line-height: 1.7;
      -webkit-font-smoothing: antialiased;
    }

    .container {
      max-width: 860px;
      margin: 0 auto;
      padding: 60px 24px;
    }

    header {
      text-align: center;
      margin-bottom: 70px;
      padding-bottom: 40px;
      border-bottom: 1px solid var(--border-color);
    }

    .tagline {
      display: inline-block;
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--accent-color);
      background: #eef4f0;
      padding: 4px 14px;
      border-radius: 20px;
      margin-bottom: 16px;
    }

    h1 {
      font-size: 2.5rem;
      font-weight: 600;
      letter-spacing: -0.5px;
      color: var(--text-main);
      margin-bottom: 12px;
    }

    header p {
      color: var(--text-muted);
      font-size: 1.05rem;
      font-weight: 300;
    }

    .post-grid {
      display: grid;
      gap: 32px;
    }

    .post-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 32px;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
    }

    .post-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 30px rgba(46, 91, 68, 0.08);
      border-color: #d1ddd6;
    }

    .post-date {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 8px;
    }

    .post-title {
      font-size: 1.4rem;
      font-weight: 600;
      color: var(--text-main);
      margin-bottom: 12px;
      line-height: 1.35;
    }

    .post-desc {
      color: var(--text-muted);
      font-size: 0.98rem;
      font-weight: 300;
    }

    .empty-state {
      text-align: center;
      padding: 60px 0;
      color: var(--text-muted);
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <span class="tagline">A.I. HEALTH INSIGHTS</span>
      <h1>🌿 VITA 健康生命智库</h1>
      <p>探索科学营养、睡眠管理与现代前沿抗衰老指南</p>
    </header>

    <main class="post-grid">
      {posts.length === 0 ? (
        <div class="empty-state">
          <p>🌱 正在撰写精选文章，请稍后刷新...</p>
        </div>
      ) : (
        posts.map((post) => (
          <article class="post-card">
            <div class="post-date">
              {post.data.pubDate ? post.data.pubDate.toISOString().split('T')[0] : '最近发布'}
            </div>
            <h2 class="post-title">{post.data.title}</h2>
            <p class="post-desc">{post.data.description}</p>
          </article>
        ))
      )}
    </main>
  </div>
</body>
</html>
