---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

// 按时间降序排序
allPosts.sort((a, b) => {
  const dateA = new Date(a.data.pubDate || 0).getTime();
  const dateB = new Date(b.data.pubDate || 0).getTime();
  return dateB - dateA;
});

// 提取最新一篇作为 Hero 文章
const heroPost = allPosts[0];
const gridPosts = allPosts.slice(1);

// 辅助函数：处理中英文和智能免 Token 配图
const parsePost = (post) => {
  if (!post) return null;
  const fullTitle = post.data.title || '';
  const fullDesc = post.data.description || '';
  let titleCn = fullTitle, titleEn = fullTitle;
  if (fullTitle.includes('|')) {
    const parts = fullTitle.split('|');
    titleCn = parts[0].trim();
    titleEn = parts[1].trim();
  }
  let descCn = fullDesc, descEn = fullDesc;
  if (fullDesc.includes('【English Summary】')) {
    const descParts = fullDesc.split('【English Summary】');
    descCn = descParts[0].replace('【中文摘要】', '').trim();
    descEn = descParts[1].trim();
  }
  // 核心修复：纯净获取 slug 并移除 .md 后缀
  const rawId = post.slug || post.id || '';
  const cleanSlug = rawId.replace(/\.[^/.]+$/, "");
  
  // 智能配图逻辑 (0 额外 Token 消耗)：
  // 1. 优先采用 Frontmatter 显式指定的 image
  // 2. 其次根据文章分类 (category) 或 slug 自动映射 Unsplash 免费学术图库
  // 3. 保底使用 DiceBear 矢量图形
  const category = post.data.category || 'biology,health';
  const fallbackDiceBear = `https://api.dicebear.com/8.x/shapes/svg?seed=${cleanSlug}&backgroundColor=f0f4f1,e2ebe5`;
  
  let imageUrl = post.data.image;
  if (!imageUrl) {
    if (post.data.category) {
      imageUrl = `https://source.unsplash.com/800x450/?${encodeURIComponent(post.data.category)},science`;
    } else {
      imageUrl = fallbackDiceBear;
    }
  }

  return {
    ...post,
    titleCn,
    titleEn,
    descCn,
    descEn,
    cleanSlug,
    imageUrl,
    date: post.data.pubDate ? new Date(post.data.pubDate).toISOString().split('T')[0] : 'Recently Published'
  };
};

const hero = parsePost(heroPost);
const grid = gridPosts.map(parsePost);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VITA Longevity Repository | 前沿健康生命智库</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Noto+Serif+SC:wght@300;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-color: #fbfbf9;
      --card-bg: #ffffff;
      --text-primary: #121815;
      --text-muted: #64746b;
      --border-color: #eaedea;
      --accent-color: #1e3a2b;
      --accent-light: #f0f4f1;
      --serif-font: 'Noto Serif SC', serif;
      --sans-font: 'Plus Jakarta Sans', sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg-color);
      color: var(--text-primary);
      font-family: var(--sans-font);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .container {
      max-width: 1140px;
      margin: 0 auto;
      padding: 30px 24px;
      width: 100%;
      flex: 1;
    }

    /* Glocal Nav Header */
    header.site-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 40px;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--border-color);
    }

    .logo-group {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .logo-v {
      background: var(--accent-color);
      color: white;
      font-weight: 700;
      width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 6px;
      font-size: 1.1rem;
    }

    .logo-text-group {
      display: flex;
      flex-direction: column;
    }

    .logo-text {
      font-size: 1.15rem;
      font-weight: 600;
      color: var(--text-primary);
      text-decoration: none;
      line-height: 1.2;
    }

    .logo-subtext {
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--accent-color);
      font-weight: 600;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .badge-peer {
      font-size: 0.72rem;
      background: var(--accent-light);
      color: var(--accent-color);
      border: 1px solid #d8e2dc;
      padding: 4px 10px;
      border-radius: 12px;
      font-weight: 500;
    }

    .lang-toggle {
      background: transparent;
      border: 1px solid var(--border-color);
      color: var(--text-muted);
      font-size: 0.75rem;
      font-weight: 500;
      padding: 5px 12px;
      border-radius: 16px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .lang-toggle:hover {
      background: var(--accent-light);
      border-color: #d8e2dc;
      color: var(--accent-color);
    }

    /* Hero 大图全宽区域 */
    .hero-section {
      margin-bottom: 60px;
      display: block;
      text-decoration: none;
      color: inherit;
    }

    .hero-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      overflow: hidden;
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .hero-section:hover .hero-card {
      transform: translateY(-4px);
      box-shadow: 0 16px 40px rgba(30, 58, 43, 0.04);
    }

    .hero-image-wrapper {
      position: relative;
      overflow: hidden;
    }

    .hero-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }

    .hero-section:hover .hero-image {
      transform: scale(1.03);
    }

    .hero-content {
      padding: 40px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .hero-meta-bar {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 12px;
    }

    .feat-tag {
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--accent-color);
      background: var(--accent-light);
      padding: 4px 10px;
      border-radius: 4px;
      display: inline-block;
    }

    .hero-date {
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    .hero-title {
      font-size: 1.85rem;
      font-weight: 600;
      line-height: 1.3;
      margin-bottom: 16px;
      color: var(--text-primary);
      letter-spacing: -0.6px;
      font-family: var(--sans-font);
    }

    .hero-desc {
      font-size: 0.98rem;
      color: var(--text-muted);
      line-height: 1.6;
      font-weight: 300;
    }

    /* 下方卡片网格 */
    .grid-section-title {
      font-size: 1.2rem;
      font-weight: 600;
      margin-bottom: 24px;
      color: var(--text-primary);
      padding-bottom: 10px;
      border-bottom: 2px solid var(--accent-light);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .post-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 30px;
    }

    .post-card-link {
      display: block;
      text-decoration: none;
      color: inherit;
    }

    .grid-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      overflow: hidden;
      height: 100%;
      display: flex;
      flex-direction: column;
      transition: all 0.25s ease;
    }

    .post-card-link:hover .grid-card {
      border-color: #c8d2cb;
      transform: translateY(-2px);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
    }

    .grid-image-wrapper {
      height: 180px;
      overflow: hidden;
    }

    .grid-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s ease;
    }

    .post-card-link:hover .grid-image {
      transform: scale(1.05);
    }

    .grid-content {
      padding: 22px;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
    }

    .grid-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
    }

    .grid-evidence-badge {
      font-size: 0.7rem;
      color: var(--accent-color);
      font-weight: 600;
      background: var(--accent-light);
      padding: 2px 6px;
      border-radius: 4px;
    }

    .grid-date {
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    .grid-title {
      font-size: 1.12rem;
      font-weight: 600;
      line-height: 1.4;
      margin-bottom: 10px;
      color: var(--text-primary);
      letter-spacing: -0.2px;
    }

    .grid-desc {
      font-size: 0.9rem;
      color: var(--text-muted);
      font-weight: 300;
      line-height: 1.55;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* 智库级 Footer 页脚 */
    footer.site-footer {
      background: #0f1715;
      color: #94a3b8;
      margin-top: 80px;
      padding: 48px 0 32px 0;
      font-size: 0.8rem;
      border-top: 1px solid var(--border-color);
    }

    .footer-container {
      max-width: 1140px;
      margin: 0 auto;
      padding: 0 24px;
    }

    .footer-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      border-bottom: 1px solid #1e2925;
      padding-bottom: 24px;
      margin-bottom: 24px;
      gap: 20px;
      flex-wrap: wrap;
    }

    .footer-brand h3 {
      color: #f8fafc;
      font-size: 1rem;
      font-weight: 600;
      margin-bottom: 4px;
    }

    .footer-brand p {
      color: #64748b;
      font-size: 0.8rem;
      max-width: 600px;
    }

    .footer-grade {
      color: #34d399;
      font-family: monospace;
      font-size: 0.75rem;
      background: rgba(52, 211, 153, 0.1);
      border: 1px solid rgba(52, 211, 153, 0.2);
      padding: 4px 10px;
      border-radius: 6px;
    }

    .disclaimer-title {
      color: #cbd5e1;
      font-weight: 600;
      margin-bottom: 4px;
    }

    .disclaimer-text {
      color: #64748b;
      line-height: 1.6;
      font-size: 0.75rem;
    }

    /* Mobile Responsive */
    @media (max-width: 800px) {
      .hero-card {
        grid-template-columns: 1fr;
      }
      .hero-image-wrapper {
        height: 220px;
      }
      .hero-content {
        padding: 24px;
      }
      .hero-title {
        font-size: 1.5rem;
      }
      .badge-peer {
        display: none;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <header class="site-header">
      <div class="logo-group">
        <div class="logo-v">V</div>
        <div class="logo-text-group">
          <a href="/" class="logo-text">VITA Repository</a>
          <span class="logo-subtext">Longevity Science</span>
        </div>
      </div>
      <div class="header-actions">
        <span class="badge-peer">🔬 Peer-Reviewed Database</span>
        <button class="lang-toggle" id="globalLangBtn" onclick="toggleGlobalLang()">🌐 ZH / 中文</button>
      </div>
    </header>

    {hero ? (
      <a href={`/blog/${hero.cleanSlug}`} class="hero-section">
        <article class="hero-card">
          <div class="hero-image-wrapper">
            <img src={hero.imageUrl} alt={hero.titleEn} class="hero-image" loading="lazy" />
          </div>
          <div class="hero-content">
            <div class="hero-meta-bar">
              <span class="feat-tag">Featured Paper</span>
              <span class="hero-date">{hero.date}</span>
            </div>
            
            <h1 class="hero-title lang-en">{hero.titleEn}</h1>
            <h1 class="hero-title lang-cn" style="display: none;">{hero.titleCn}</h1>
            
            <p class="hero-desc lang-en">{hero.descEn}</p>
            <p class="hero-desc lang-cn" style="display: none;">{hero.descCn}</p>
          </div>
        </article>
      </a>
    ) : (
      <div class="empty-state">
        <p>Loading longevity repository...</p>
      </div>
    )}

    {grid.length > 0 && (
      <section class="grid-section">
        <h2 class="grid-section-title">
          <span class="lang-en">Research Archive</span>
          <span class="lang-cn" style="display: none;">文献智库归档</span>
          <span style="font-size: 0.8rem; font-weight: normal; color: var(--text-muted);">{grid.length + 1} papers published</span>
        </h2>
        
        <div class="post-grid">
          {grid.map((post) => (
            <a href={`/blog/${post.cleanSlug}`} class="post-card-link">
              <article class="grid-card">
                <div class="grid-image-wrapper">
                  <img src={post.imageUrl} alt={post.titleEn} class="grid-image" loading="lazy" />
                </div>
                <div class="grid-content">
                  <div class="grid-meta">
                    <span class="grid-evidence-badge">Grade-A Evidence</span>
                    <span class="grid-date">{post.date}</span>
                  </div>
                  
                  <h3 class="grid-title lang-en">{post.titleEn}</h3>
                  <h3 class="grid-title lang-cn" style="display: none;">{post.titleCn}</h3>
                  
                  <p class="grid-desc lang-en">{post.descEn}</p>
                  <p class="grid-desc lang-cn" style="display: none;">{post.descCn}</p>
                </div>
              </article>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>

  <footer class="site-footer">
    <div class="footer-container">
      <div class="footer-top">
        <div class="footer-brand">
          <h3>VITA Longevity Institute</h3>
          <p>Translating cutting-edge clinical neuroscience, cellular metabolism, and longevity research into actionable human protocols.</p>
        </div>
        <div class="footer-grade">
          Grade-A Clinical Focus
        </div>
      </div>
      <div class="disclaimer-box">
        <div class="disclaimer-title">MEDICAL DISCLAIMER</div>
        <p class="disclaimer-text">
          The content published on VITA Repository is strictly for academic, educational, and research informational purposes. It does not constitute formal medical advice, clinical diagnosis, or treatment protocols. Never disregard professional medical advice or delay seeking it because of information read on this portal.
        </p>
        <p class="disclaimer-text" style="margin-top: 12px; color: #475569;">
          © {new Date().getFullYear()} VITA Longevity Institute. All rights reserved. Indexed in Open Research Databases.
        </p>
      </div>
    </div>
  </footer>

  <script is:inline>
    function formatPageByLang(lang) {
      const enEls = document.querySelectorAll('.lang-en');
      const cnEls = document.querySelectorAll('.lang-cn');
      const btn = document.getElementById('globalLangBtn');

      if (lang === 'zh') {
        enEls.forEach(el => el.style.display = 'none');
        cnEls.forEach(el => el.style.display = 'block');
        if (btn) btn.innerText = '🌐 EN / English';
      } else {
        enEls.forEach(el => el.style.display = 'block');
        cnEls.forEach(el => el.style.display = 'none');
        if (btn) btn.innerText = '🌐 ZH / 中文';
      }
    }

    let currentLang = localStorage.getItem('vita_lang') || 'en';

    function toggleGlobalLang() {
      currentLang = currentLang === 'en' ? 'zh' : 'en';
      localStorage.setItem('vita_lang', currentLang);
      formatPageByLang(currentLang);
    }

    document.addEventListener('DOMContentLoaded', () => {
      formatPageByLang(currentLang);
    });
  </script>
</body>
</html>
