---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');

// 按时间降序排序
posts.sort((a, b) => {
  const dateA = new Date(a.data.pubDate || 0).getTime();
  const dateB = new Date(b.data.pubDate || 0).getTime();
  return dateB - dateA;
});
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VITA | Health & Longevity Research Institute</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-color: #fbfbf9;
      --card-bg: #ffffff;
      --text-primary: #121815;
      --text-muted: #64746b;
      --border-color: #eaedea;
      --accent-color: #1e3a2b;
      --accent-light: #f0f4f1;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg-color);
      color: var(--text-primary);
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    .container {
      max-width: 800px;
      margin: 0 auto;
      padding: 60px 24px;
    }

    /* Navigation Header */
    header.site-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 60px;
      padding-bottom: 24px;
      border-bottom: 1px solid var(--border-color);
    }

    .logo {
      font-size: 1.25rem;
      font-weight: 600;
      letter-spacing: -0.3px;
      color: var(--accent-color);
      text-decoration: none;
    }

    .subtitle {
      font-size: 0.82rem;
      color: var(--text-muted);
      font-weight: 400;
      margin-top: 2px;
    }

    .lang-toggle {
      background: var(--accent-light);
      border: 1px solid #d8e2dc;
      color: var(--accent-color);
      font-size: 0.78rem;
      font-weight: 600;
      padding: 6px 14px;
      border-radius: 20px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .lang-toggle:hover {
      background: #e2ebe5;
    }

    /* Hero Section */
    .hero {
      margin-bottom: 50px;
    }

    .hero h1 {
      font-size: 2.2rem;
      font-weight: 600;
      line-height: 1.3;
      letter-spacing: -0.8px;
      margin-bottom: 12px;
      color: var(--text-primary);
    }

    .hero p {
      color: var(--text-muted);
      font-size: 1.05rem;
      font-weight: 300;
    }

    /* Post Grid */
    .post-grid {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .post-card-link {
      display: block;
      text-decoration: none;
      color: inherit;
      cursor: pointer;
    }

    .post-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 30px;
      transition: all 0.25s ease;
    }

    .post-card-link:hover .post-card {
      border-color: #c8d2cb;
      transform: translateY(-2px);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
    }

    .post-date {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-bottom: 10px;
      font-weight: 500;
      letter-spacing: 0.5px;
    }

    .post-title {
      font-size: 1.35rem;
      font-weight: 600;
      line-height: 1.4;
      margin-bottom: 10px;
      color: var(--text-primary);
      letter-spacing: -0.3px;
    }

    .post-desc {
      font-size: 0.95rem;
      color: var(--text-muted);
      font-weight: 300;
      line-height: 1.6;
    }

    footer {
      margin-top: 80px;
      padding-top: 30px;
      border-top: 1px solid var(--border-color);
      text-align: center;
      font-size: 0.8rem;
      color: var(--text-muted);
    }
  </style>
</head>
<body>
  <div class="container">
    <header class="site-header">
      <div>
        <a href="/" class="logo">VITA</a>
        <div class="subtitle">前沿健康与生命科学智库</div>
      </div>
      <button class="lang-toggle" id="globalLangBtn" onclick="toggleGlobalLang()">🌐 ZH / 中文</button>
    </header>

    <section class="hero">
      <h1 class="lang-en">VITA Research Repository</h1>
      <h1 class="lang-cn" style="display: none;">VITA 健康生命智库</h1>
      <p class="lang-en">Evidence-based insights on nutrition, circadian rhythms, autophagy, and longevity science.</p>
      <p class="lang-cn" style="display: none;">探索科学营养、昼夜节律、细胞自噬与现代抗衰老前沿指南</p>
    </section>

    <main class="post-grid">
      {posts.length === 0 ? (
        <div class="empty-state">
          <p>Loading research repository...</p>
        </div>
      ) : (
        posts.map((post) => {
          const fullTitle = post.data.title || '';
          const fullDesc = post.data.description || '';
          
          let titleCn = fullTitle, titleEn = fullTitle;
          if (fullTitle.includes('|')) {
            const parts = fullTitle.split('|');
            titleCn = parts[0].trim();
            titleEn = parts[1].trim();
          }

          let descCn = fullDesc, descEn = fullDesc;
          if (fullDesc.includes('【English Summary】')) {
            const descParts = fullDesc.split('【English Summary】');
            descCn = descParts[0].replace('【中文摘要】', '').trim();
            descEn = descParts[1].trim();
          }

          // 核心修复：纯净获取 slug 并移除 .md 后缀
          const rawId = post.slug || post.id || '';
          const cleanSlug = rawId.replace(/\.[^/.]+$/, "");

          return (
            <a href={`/blog/${cleanSlug}`} class="post-card-link">
              <article class="post-card">
                <div class="post-date">
                  {post.data.pubDate ? post.data.pubDate.toISOString().split('T')[0] : 'Recently Published'}
                </div>
                <h2 class="post-title lang-en">{titleEn}</h2>
                <h2 class="post-title lang-cn" style="display: none;">{titleCn}</h2>
                
                <p class="post-desc lang-en">{descEn}</p>
                <p class="post-desc lang-cn" style="display: none;">{descCn}</p>
              </article>
            </a>
          );
        })
      )}
    </main>

    <footer>
      <p>© 2026 VITA Longevity Institute. All rights reserved.</p>
    </footer>
  </div>

  <script is:inline>
    function formatPageByLang(lang) {
      const enEls = document.querySelectorAll('.lang-en');
      const cnEls = document.querySelectorAll('.lang-cn');
      const btn = document.getElementById('globalLangBtn');

      if (lang === 'zh') {
        enEls.forEach(el => el.style.display = 'none');
        cnEls.forEach(el => el.style.display = 'block');
        if (btn) btn.innerText = '🌐 EN / English';
      } else {
        enEls.forEach(el => el.style.display = 'block');
        cnEls.forEach(el => el.style.display = 'none');
        if (btn) btn.innerText = '🌐 ZH / 中文';
      }
    }

    let currentLang = localStorage.getItem('vita_lang') || 'en';

    function toggleGlobalLang() {
      currentLang = currentLang === 'en' ? 'zh' : 'en';
      localStorage.setItem('vita_lang', currentLang);
      formatPageByLang(currentLang);
    }

    document.addEventListener('DOMContentLoaded', () => {
      formatPageByLang(currentLang);
    });
  </script>
</body>
</html>
