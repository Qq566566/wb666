---
import { getCollection } from 'astro:content';

let posts = [];
try {
  posts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
} catch (e) {
  console.error(e);
}
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>我的 AI 自动化 SEO 博客</title>
</head>
<body style="max-width: 800px; margin: 0 auto; padding: 40px 20px; font-family: system-ui, sans-serif; line-height: 1.6;">
  <header style="margin-bottom: 40px; border-bottom: 2px solid #eee; padding-bottom: 20px;">
    <h1>🚀 AI 自动化 SEO 博客</h1>
    <p>每天由智能体自动更新</p>
  </header>
  
  <main>
    {posts.length === 0 ? (
      <p>暂无文章，等待自动生成...</p>
    ) : (
      <ul style="list-style: none; padding: 0;">
        {posts.map((post) => (
          <li style="margin-bottom: 20px; padding: 15px; border: 1px solid #ddd; border-radius: 8px;">
            <h2>{post.data.title}</h2>
            <p style="color: #666; font-size: 0.9em;">发布日期: {post.data.pubDate.toISOString().split('T')[0]}</p>
            <p>{post.data.description}</p>
          </li>
        ))}
      </ul>
    )}
  </main>
</body>
</html>
