---
import { getCollection } from 'astro:content';

let posts = [];
try {
  posts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
} catch (e) {
  console.error(e);
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VITA | Health & Longevity Research Institute</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --bg-color: #fbfbf9;
      --card-bg: #ffffff;
      --text-primary: #121815;
      --text-muted: #64746b;
      --border-color: #eaedea;
      --accent-color: #1e3a2b;
      --accent-light: #f0f4f1;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg-color);
      color: var(--text-primary);
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      line-height: 1.7;
      -webkit-font-smoothing: antialiased;
    }

    .container {
      max-width: 820px;
      margin: 0 auto;
      padding: 40px 24px 80px 24px;
    }

    /* Top Navigation bar */
    nav {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 30px;
      margin-bottom: 50px;
      border-bottom: 1px solid var(--border-color);
    }

    .brand-logo {
      font-size: 1.1rem;
      font-weight: 600;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--accent-color);
    }

    .lang-switcher {
      background: var(--accent-light);
      border: 1px solid #d8e2dc;
      color: var(--accent-color);
      font-size: 0.75rem;
      font-weight: 600;
      padding: 6px 14px;
      border-radius: 20px;
      cursor: pointer;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .lang-switcher:hover {
      background: #e2ebe5;
    }

    /* Header */
    header {
      text-align: center;
      margin-bottom: 60px;
    }

    .hero-tag {
      display: inline-block;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      color: var(--accent-color);
      margin-bottom: 16px;
    }

    h1 {
      font-size: 2.4rem;
      font-weight: 500;
      letter-spacing: -0.5px;
      color: var(--text-primary);
      margin-bottom: 16px;
      line-height: 1.25;
    }

    header p {
      color: var(--text-muted);
      font-size: 1.05rem;
      font-weight: 300;
      max-width: 600px;
      margin: 0 auto;
    }

    /* Post list */
    .post-grid {
      display: grid;
      gap: 28px;
    }

    .post-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 14px;
      padding: 32px;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.015);
    }

    .post-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(30, 58, 43, 0.06);
      border-color: #d8e2dc;
    }

    .post-date {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-bottom: 10px;
      font-weight: 400;
      letter-spacing: 0.5px;
    }

    .post-title {
      font-size: 1.35rem;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 12px;
      line-height: 1.4;
    }

    .post-desc {
      color: var(--text-muted);
      font-size: 0.96rem;
      font-weight: 300;
      line-height: 1.6;
    }

    .empty-state {
      text-align: center;
      padding: 60px 0;
      color: var(--text-muted);
      font-weight: 300;
    }

    footer {
      margin-top: 80px;
      padding-top: 30px;
      border-top: 1px solid var(--border-color);
      text-align: center;
      font-size: 0.8rem;
      color: var(--text-muted);
    }
  </style>
</head>
<body>
  <div class="container">
    <nav>
      <div class="brand-logo">VITA</div>
      <button class="lang-switcher" id="langBtn" onclick="toggleLanguage()">
        🌐 <span id="btnText">ZH / 中文</span>
      </button>
    </nav>

    <header>
      <span class="hero-tag" id="heroTag">CLINICAL & LONGEVITY RESEARCH</span>
      <h1 id="heroTitle">Health Science & Precision Longevity</h1>
      <p id="heroDesc">Translating frontier cellular medicine, circadian biology, and nutritional science into evidence-based longevity strategies.</p>
    </header>

    <main class="post-grid">
      {posts.length === 0 ? (
        <div class="empty-state">
          <p id="emptyText">Loading research repository...</p>
        </div>
      ) : (
        posts.map((post) => {
          const fullTitle = post.data.title || '';
          const fullDesc = post.data.description || '';
          
          let titleCn = fullTitle, titleEn = fullTitle;
          if (fullTitle.includes('|')) {
            const parts = fullTitle.split('|');
            titleCn = parts[0].trim();
            titleEn = parts[1].trim();
          }

          let descCn = fullDesc, descEn = fullDesc;
          if (fullDesc.includes('【English Summary】')) {
            const descParts = fullDesc.split('【English Summary】');
            descCn = descParts[0].replace('【中文摘要】', '').trim();
            descEn = descParts[1].trim();
          }

          return (
            <a 
              href={`/blog/${post.id}`} 
              style="text-decoration: none; color: inherit; display: block; cursor: pointer; width: 100%;"
            >
              <article class="post-card">
                <div class="post-date">
                  {post.data.pubDate ? post.data.pubDate.toISOString().split('T')[0] : 'Recently Published'}
                </div>
                <h2 class="post-title lang-en">{titleEn}</h2>
                <h2 class="post-title lang-cn" style="display: none;">{titleCn}</h2>
                
                <p class="post-desc lang-en">{descEn}</p>
                <p class="post-desc lang-cn" style="display: none;">{descCn}</p>
              </article>
            </a>
          );
        })
      )}
    </main>

    <footer>
      <p id="footerText">© 2026 VITA Longevity Institute. All rights reserved.</p>
    </footer>
  </div>

  <script is:inline>
    // 语言初始化与切换脚本
    const i18n = {
      en: {
        btnText: "ZH / 中文",
        heroTag: "CLINICAL & LONGEVITY RESEARCH",
        heroTitle: "Health Science & Precision Longevity",
        heroDesc: "Translating frontier cellular medicine, circadian biology, and nutritional science into evidence-based longevity strategies.",
        emptyText: "Loading research repository...",
        footerText: "© 2026 VITA Longevity Institute. All rights reserved."
      },
      zh: {
        btnText: "EN / English",
        heroTag: "前沿健康与生命科学智库",
        heroTitle: "VITA 健康生命智库",
        heroDesc: "探索科学营养、昼夜节律、细胞自噬与现代抗衰老前沿指南",
        emptyText: "正在整理最新健康研究指南...",
        footerText: "© 2026 VITA 健康生命研究院. 保留所有权利."
      }
    };

    let currentLang = 'en'; // 默认英文

    function detectLanguage() {
      // 1. 优先读取用户之前手动点击保存的语言
      const savedLang = localStorage.getItem('vita_lang');
      if (savedLang) {
        return savedLang;
      }
      // 2. 否则自动识别浏览器语言（若是中文环境则默认为 zh，其他地区全为 en）
      const userLang = navigator.language || navigator.userLanguage;
      if (userLang && userLang.toLowerCase().startsWith('zh')) {
        return 'zh';
      }
      return 'en';
    }

    function applyLanguage(lang) {
      currentLang = lang;
      localStorage.setItem('vita_lang', lang);

      // 更新 HTML 标签
      document.documentElement.lang = lang === 'zh' ? 'zh-CN' : 'en';

      // 更新文案
      const texts = i18n[lang];
      document.getElementById('btnText').innerText = texts.btnText;
      document.getElementById('heroTag').innerText = texts.heroTag;
      document.getElementById('heroTitle').innerText = texts.heroTitle;
      document.getElementById('heroDesc').innerText = texts.heroDesc;
      if (document.getElementById('emptyText')) {
        document.getElementById('emptyText').innerText = texts.emptyText;
      }
      document.getElementById('footerText').innerText = texts.footerText;

      // 切换文章列表元素的显示/隐藏
      const enElems = document.querySelectorAll('.lang-en');
      const cnElems = document.querySelectorAll('.lang-cn');

      if (lang === 'zh') {
        enElems.forEach(el => el.style.display = 'none');
        cnElems.forEach(el => el.style.display = 'block');
      } else {
        enElems.forEach(el => el.style.display = 'block');
        cnElems.forEach(el => el.style.display = 'none');
      }
    }

    function toggleLanguage() {
      const nextLang = currentLang === 'en' ? 'zh' : 'en';
      applyLanguage(nextLang);
    }

    // 页面加载完成后自动应用检测到的语言
    document.addEventListener('DOMContentLoaded', () => {
      const initialLang = detectLanguage();
      applyLanguage(initialLang);
    });
  </script>
</body>
</html>
